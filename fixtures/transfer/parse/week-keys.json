{
  "description": "Week keys need exactly four, two and two ASCII digits: full-width digits, a trailing newline and a single-digit month all drop out, in plans and in the log.",
  "input": {
    "format": "exercise-planner-export",
    "version": 1,
    "exercise": {
      "plans": {
        "2026-10-19": [{ "id": "a", "name": "A", "reps": 1, "target": 1 }],
        "２０２６-10-26": [{ "id": "a", "name": "A", "reps": 1, "target": 1 }],
        "2026-11-02\n": [{ "id": "a", "name": "A", "reps": 1, "target": 1 }],
        "2026-1-09": [{ "id": "a", "name": "A", "reps": 1, "target": 1 }]
      },
      "log": {
        "2026-10-19": { "a": [true] },
        "２０２６-10-26": { "a": [true] },
        "2026-11-02\n": { "a": [true] }
      }
    }
  },
  "expected": {
    "ok": true,
    "data": {
      "exercise": {
        "plans": { "2026-10-19": [{ "id": "a", "name": "A", "reps": 1, "target": 1 }] },
        "log": { "2026-10-19": { "a": [true, false, false, false, false, false, false] } }
      },
      "diet": { "plans": {}, "log": {} },
      "settings": null
    }
  }
}
