{
  "description": "Bad fields are normalised exactly as stored data is: bad weeks and items drop out, numbers clamp, logs pad to seven booleans, the theme is ignored.",
  "input": {
    "format": "fitness-planner-export",
    "version": 1,
    "exercise": {
      "plans": {
        "2026-10-19": [
          { "id": "a", "name": "A", "sets": 30, "reps": -3, "weight": 0.004, "target": 9 },
          { "name": "no id" },
          "junk",
          {
            "id": "b",
            "name": "B",
            "sets": 0,
            "reps": 2.6,
            "perSide": "yes",
            "weight": -5,
            "target": "x"
          }
        ],
        "not-a-week": [{ "id": "c", "name": "C", "reps": 1, "target": 1 }],
        "2026-10-26": "not an array"
      },
      "log": {
        "2026-10-19": { "a": [true, 1, "true", true], "b": "nope" },
        "bad": { "a": [true] }
      }
    },
    "diet": {
      "plans": {
        "2026-10-19": [
          { "id": "f", "name": "F", "target": -2 },
          { "id": 5, "name": "x" }
        ]
      }
    },
    "settings": { "accent": "red", "dailyPick": 20, "theme": "dark" }
  },
  "expected": {
    "ok": true,
    "data": {
      "exercise": {
        "plans": {
          "2026-10-19": [
            { "id": "a", "name": "A", "sets": 20, "reps": 0, "target": 7 },
            { "id": "b", "name": "B", "reps": 3, "target": 3 }
          ]
        },
        "log": { "2026-10-19": { "a": [true, false, false, true, false, false, false] } }
      },
      "diet": {
        "plans": { "2026-10-19": [{ "id": "f", "name": "F", "target": 0 }] },
        "log": {}
      },
      "settings": { "accent": "#30d158", "dailyPick": 8 }
    }
  }
}
