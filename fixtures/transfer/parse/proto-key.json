{
  "description": "A log entry keyed __proto__ is dropped: in JavaScript, assigning it sets the object's prototype instead of adding an entry.",
  "input": {
    "format": "exercise-planner-export",
    "version": 1,
    "exercise": { "log": { "2026-10-19": { "__proto__": [true], "b": [true] } } }
  },
  "expected": {
    "ok": true,
    "data": {
      "exercise": {
        "plans": {},
        "log": { "2026-10-19": { "b": [true, false, false, false, false, false, false] } }
      },
      "diet": { "plans": {}, "log": {} },
      "settings": null
    }
  }
}
